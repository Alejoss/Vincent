# Copy to .env and fill in (never commit .env)

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_DM_CHANNEL_ID=
SLACK_WORKSPACE_DOMAIN=
# SLACK_HUMAN_USER_ID=
# Pipeline 2 (Notion → Slack reminders). Defaults in script if unset:
# SLACK_REMINDER_EXCLUDE_STATUS=Hecho,Terminado,Listo,Done

# --- Obsidian vault (sibling folder in monorepo) ---
OBSIDIAN_VAULT_PATH=../Cerebro-Vincent
SLACK_INPUT_OBSIDIAN_REL=0_Diario_Productividad/Input

# --- Notion ---
NOTION_API_TOKEN=secret_...
# NOTION_TASKS_DATABASE_ID=

# --- OpenAI (Whisper audio + classifier LLM — same key, no WHISPER_API_KEY) ---
OPENAI_API_KEY=
# WHISPER_PROVIDER=auto
# LLM_PROVIDER=auto
# LLM_MODEL=gpt-4o-mini
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=dolphin-llama3:8b

# --- Optional Groq instead of OpenAI ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

