# --- Bitcoin Cash payment verify (scripts/verify_bch_payment.py) ---
# Same keys as Sophia. Default network is chipnet unless ENVIRONMENT=PRODUCTION.
# BCH_NETWORK=mainnet
# BCH_RECEIVE_ADDRESS_MAINNET=bitcoincash:q...
# BCH_RECEIVE_ADDRESS_CHIPNET=bchtest:q...
# BCH_API_BASE=ssl://bch.imaginary.cash:50002
# BCH_USD_PRICE=0
# BCH_MIN_CONFIRMATIONS=0
# BCH_PAYMENT_TTL_MINUTES=30
# BCH_AMOUNT_TOLERANCE_USD=0.20
# BCH_VERIFY_TIMESTAMP_GRACE_SECONDS=
# --- Sophia (transcript + embedding ingest, same key) ---
# SOPHIA_API_BASE=https://www.academiablockchain.com/api
# TRANSCRIPT_INGEST_API_KEY=

