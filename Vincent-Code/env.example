# Copy to .env and fill in (never commit .env)

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_DM_CHANNEL_ID=
SLACK_WORKSPACE_DOMAIN=
# SLACK_HUMAN_USER_ID=

# --- Obsidian vault (sibling folder in monorepo) ---
OBSIDIAN_VAULT_PATH=../Cerebro-Vincent
SLACK_INPUT_OBSIDIAN_REL=0_Diario_Productividad/Input

# --- Notion ---
NOTION_API_TOKEN=secret_...
# NOTION_TASKS_DATABASE_ID=
# NOTION_EMBEDDING_STATUS_DATABASE_ID=9dc0455d716344c68c207ee4011ad2e1
# https://www.notion.so/9dc0455d716344c68c207ee4011ad2e1
# Share that DB with the Vincent Notion integration (NOTION_API_TOKEN).

# --- OpenAI (Whisper audio + classifier LLM — same key, no WHISPER_API_KEY) ---
OPENAI_API_KEY=
# WHISPER_PROVIDER=auto
# LLM_PROVIDER=auto
# LLM_MODEL=gpt-4o-mini
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=dolphin-llama3:8b

# --- YouTube channel transcripts (scripts/process_youtube_channel.py) ---
# YOUTUBE_API_KEY=...                    # listar vídeos del canal (solo metadatos)
# YOUTUBE_CHANNEL_URL=https://www.youtube.com/@AcademiaBlockchain
# YOUTUBE_TRANSCRIPT_LANGUAGES=es,es-419,en
# YOUTUBE_OWN_TRANSCRIPTS_FOLDER=Own_Transcripts
# YOUTUBE_CAPTION_METHOD=oauth           # oauth (recomendado) | scraper (legacy)
# YOUTUBE_OAUTH_DAILY_QUOTA_BUDGET=9000  # ~36 vídeos/día (250 unidades c/u)
# YOUTUBE_OAUTH_DELAY_SECONDS=0.5
#
# OAuth — GOOGLE_OAUTH_CLIENT_ID + GOOGLE_OAUTH_SECRET en .env, o client_secret.json:
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_SECRET=...
# YOUTUBE_OAUTH_CLIENT_SECRETS=cache/youtube_oauth/client_secret.json
#
# Primera vez: python scripts/youtube_oauth_login.py

# --- Local video transcripts (scripts/process_local_videos.py) ---
# LOCAL_VIDEOS_INPUT_DIR=E:/Videos/MisVideos
# LOCAL_VIDEOS_EXTENSIONS=mp4,mkv,mov,avi,webm,m4v
# WHISPER_PROVIDER=auto
# LOCAL_WHISPER_MODEL=small
# WHISPER_CHUNK_SECONDS=600
# WHISPER_OPENAI_TIMEOUT=600
# WHISPER_CHUNK_LONG_AUDIO=1
# LOCAL_WHISPER_DEVICE=cuda
# LOCAL_WHISPER_COMPUTE=float16
# KNOWLEDGE_EXTRACTION_MODEL=gpt-4o

# --- Optional Groq instead of OpenAI ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Newsletter (SMTP2GO) ---
